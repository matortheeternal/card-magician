{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/dist/types/card-magician.d.ts",
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "types": []
      },
      "files": [
        "dist/types/card-magician.d.ts",
        "dist/types/card-magician-globals.d.ts"
      ]
    }
  },
  "apiReport": { "enabled": false },
  "docModel": { "enabled": false },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/card-magician.d.ts"
  },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    },
    "extractorMessageReporting": {
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-forgotten-export": { "logLevel": "none" },
      "ae-setter-with-docs": { "logLevel": "none" }
    }
  }
}
