{
  "name": "card-magician",
  "version": "1.0.0",
  "description": "A tool for creating custom playing cards.",
  "keywords": [
    "trading",
    "cards",
    "magic",
    "the",
    "gathering",
    "desktop",
    "app"
  ],
  "homepage": "https://codeberg.org/mator/card-magician#readme",
  "bugs": {
    "url": "https://codeberg.org/mator/card-magician/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/mator/card-magician.git"
  },
  "license": "MIT",
  "author": "mator",
  "type": "module",
  "workspaces": [
    "games/magic"
  ],
  "scripts": {
    "prebuild": "node tasks/installVendor.js",
    "build": "node tasks/build.js",
    "release": "node tasks/release.js",
    "dev": "node tasks/serve.js",
    "renameMseAssets": "node tasks/renameMseAssets.js",
    "smoke": "npm run build && node tasks/smoke.js",
    "start": "npm run build && concurrently --handle-input -k -n dev,app -c \"gray,green\" \"npm:dev\" \"neu run --disable-auto-reload\"",
    "mobile": "npm run build && concurrently --handle-input -k -n dev,app -c \"gray,green\" \"npm:dev\" \"neu run --disable-auto-reload -- --mode=browser\"",
    "test": "npm run build && node tasks/test.js",
    "localize": "npm run build && concurrently --handle-input -k -n dev,localize -c \"gray,green\" \"npm:dev\" \"neu run --disable-auto-reload -- --localize\"",
    "lint": "npx eslint src modules"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "codejar": "^4.3.0",
    "dompurify": "^3.4.13",
    "fuzzysort": "^3.1.0",
    "highlight.js": "^11.11.1",
    "notepack.io": "^3.0.1",
    "sanitize-filename": "^1.6.3",
    "unzipit": "^2.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/jasmine": "^6.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jasmine-core": "7.0.1",
    "ws": "^8.19.0"
  }
}
