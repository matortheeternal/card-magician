{
  "name": "card-magician",
  "version": "1.1.0",
  "description": "A tool for creating custom playing cards.",
  "keywords": [
    "trading",
    "cards",
    "magic",
    "the",
    "gathering",
    "desktop",
    "app"
  ],
  "homepage": "https://github.com/matortheeternal/card-magician#readme",
  "bugs": {
    "url": "https://github.com/matortheeternal/card-magician/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matortheeternal/card-magician.git"
  },
  "license": "MIT",
  "author": "mator",
  "type": "module",
  "workspaces": [
    "extensions/games/magic"
  ],
  "scripts": {
    "prebuild": "node tasks/installVendor.js",
    "build": "node tasks/build.js",
    "build:types": "node tasks/buildTypes.js",
    "start": "npm run build && concurrently -k -n dev,app \"npm:dev\" \"electron . --development\"",
    "start:app": "npm run build && electron .",
    "start:localize": "npm run build && electron . --development --localize",
    "dev": "node tasks/dev.js",
    "renameMseAssets": "node tasks/renameMseAssets.js",
    "test": "npm run build && node tasks/test.js",
    "test:native": "node --test electron/*.test.js",
    "smoke": "npm run build && node tasks/smoke.js",
    "test:templates": "npm run build && node tasks/templateTests.js",
    "release": "node tasks/release.js",
    "lint": "eslint src extensions/games/magic/src extensions/cardparts extensions/exporters electron tasks eslint.config.js --max-warnings 0"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "codejar": "^4.3.0",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "dompurify": "^3.4.13",
    "fuzzysort": "^3.1.0",
    "highlight.js": "^11.11.1",
    "notepack.io": "^3.0.1",
    "oracle-of-pie": "file:../oracle-of-pie",
    "sanitize-filename": "^1.6.3",
    "semver": "^7.8.6",
    "unzipit": "^2.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/jasmine": "^6.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "diff": "^9.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jasmine-core": "7.0.1",
    "typescript": "^7.0.2",
    "ws": "^8.19.0"
  },
  "main": "electron/main.js"
}
