{
  "name": "card-magician",
  "version": "1.0.1",
  "description": "A tool for creating custom playing cards.",
  "keywords": [
    "trading",
    "cards",
    "magic",
    "the",
    "gathering",
    "desktop",
    "app"
  ],
  "homepage": "https://codeberg.org/mator/card-magician#readme",
  "bugs": {
    "url": "https://codeberg.org/mator/card-magician/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/mator/card-magician.git"
  },
  "license": "MIT",
  "author": "mator",
  "type": "module",
  "workspaces": [
    "extensions/games/magic"
  ],
  "scripts": {
    "prebuild": "node tasks/installVendor.js",
    "build": "node tasks/build.js",
    "build:types": "node tasks/buildTypes.js",
    "start": "npm run build && concurrently -k -n dev,app \"npm:dev\" \"electron . --development\"",
    "start:app": "npm run build && electron .",
    "dev": "node tasks/serve.js",
    "localize": "npm run build && concurrently -k -n dev,app \"npm:dev\" \"electron . --development --localize\"",
    "renameMseAssets": "node tasks/renameMseAssets.js",
    "test": "npm run build && node tasks/test.js",
    "test:native": "node --test electron/*.test.js",
    "smoke": "npm run build && node tasks/smoke.js",
    "smoke:exit": "npm run build && node tasks/exitSmoke.js",
    "smoke:exit:mutations": "npm run build && node tasks/exitSmokeMutations.js",
    "package": "node tasks/electron/package.js --dir",
    "dist": "node tasks/electron/package.js",
    "dist:linux": "node tasks/electron/package.js --linux",
    "dist:win": "node tasks/electron/package.js --win --x64",
    "dist:mac": "node tasks/electron/package.js --mac",
    "lint": "eslint src extensions/cardparts electron tasks"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "codejar": "^4.3.0",
    "dompurify": "^3.4.13",
    "fuzzysort": "^3.1.0",
    "highlight.js": "^11.11.1",
    "notepack.io": "^3.0.1",
    "sanitize-filename": "^1.6.3",
    "unzipit": "^2.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/jasmine": "^6.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "diff": "^9.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jasmine-core": "7.0.1",
    "typescript": "^7.0.2",
    "ws": "^8.19.0"
  },
  "main": "electron/main.js"
}
