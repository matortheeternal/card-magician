{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "cardmagician",
  "version": "1.0.0",
  "defaultMode": "chrome",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "debug.log",
    "filesystem.*",
    "window.*",
    "storage.*",
    "server.*"
  ],
  "modes": {
    "window": {
      "title": "Card Magician",
      "width": 1280,
      "height": 720,
      "minWidth": 1280,
      "minHeight": 720,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "webviewArgs": "--disable-features=Autofill,PasswordManager,AutofillServerCommunication",
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "moveable": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    },
    "chrome": {
      "width": 1280,
      "height": 720,
      "args": "--user-agent=\"Neutralinojs chrome mode\" --log-level=3"
    }
  },
  "cli": {
    "binaryName": "cardMagician",
    "resourcesPath": "/resources/",
    "resourcesExclude": "^tests/.",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "copyItems": [
      "/modules/",
      "/templates/",
      "/exporters/",
      "/scripts/",
      "/locales/",
      "/games/"
    ]
  }
}
